{
  "name": "kodeklarity",
  "version": "0.3.0",
  "description": "Shared knowledge & memory of your code, for AI agents. Code graph + persistent memory layer — impact analysis, risk scoring, cross-boundary tracing, agent-to-agent knowledge sharing.",
  "type": "module",
  "author": "Vijay Singh <129295991+vjvkrm@users.noreply.github.com>",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/vjvkrm/kodeklarity#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vjvkrm/kodeklarity.git"
  },
  "bugs": {
    "url": "https://github.com/vjvkrm/kodeklarity/issues"
  },
  "keywords": [
    "code-graph",
    "impact-analysis",
    "risk-scoring",
    "ai-agents",
    "mcp",
    "mcp-server",
    "claude",
    "codex",
    "cursor",
    "typescript",
    "static-analysis",
    "nextjs",
    "drizzle",
    "agent-memory",
    "code-understanding"
  ],
  "bin": {
    "kk": "dist/bin/kk.js",
    "kk-mcp": "dist/bin/kk-mcp.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/dashboard/web/**",
    "README.md",
    "AGENT.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && npm run build:web && chmod +x dist/bin/kk.js dist/bin/kk-mcp.js",
    "build:web": "vite build --config src/dashboard/web/vite.config.ts",
    "dev:web": "vite --config src/dashboard/web/vite.config.ts",
    "start": "node ./dist/bin/kk.js",
    "dev": "npm run build && node ./dist/bin/kk.js",
    "smoke": "npm run build && node ./dist/bin/kk.js help",
    "test": "npm run build && node --test ./tests/discover.test.js ./tests/config.test.js ./tests/e2e.test.js ./tests/mcp.smoke.test.js ./tests/memory.list-stale.test.js ./tests/dashboard.server.test.js ./tests/dashboard.security.test.js ./tests/dashboard.e2e.test.js",
    "test:discover": "npm run build && node --test ./tests/discover.test.js",
    "test:config": "npm run build && node --test ./tests/config.test.js",
    "test:e2e": "npm run build && node --test ./tests/e2e.test.js",
    "test:mcp": "npm run build && node --test ./tests/mcp.smoke.test.js",
    "test:dashboard": "npm run build && node --test ./tests/dashboard.server.test.js ./tests/dashboard.security.test.js ./tests/dashboard.e2e.test.js",
    "test:coverage": "npm run build && node --experimental-test-coverage --test ./tests/discover.test.js ./tests/config.test.js ./tests/e2e.test.js ./tests/mcp.smoke.test.js",
    "test:legacy": "node --test ./tests/integration.cli.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.6.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.10.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "zustand": "^5.0.13"
  },
  "engines": {
    "node": ">=20"
  }
}
